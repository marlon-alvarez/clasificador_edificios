# Copia a .env y rellená (no subir .env al repo).

# Pod GPU :8000 — clasificador fine-tuned.
CLASSIFY_URL=https://<POD-ID>-8000.proxy.runpod.net
CLASSIFY_MODEL=gemma-3-4b-ft

# Pod GPU :8001 — modelo base para descripción / OCR / horario.
DESCRIBE_URL=https://<POD-ID>-8001.proxy.runpod.net
DESCRIBE_MODEL=gemma-3-4b-it

# Misma key para los dos procesos vLLM (se levantan con el mismo --api-key).
RUNPOD_API_KEY=tu-secreto

CLASS_NAMES=apartamento,casa,local_comercial
PORT=8080
